EIA_API_KEY=your_eia_api_key_here
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here
TULIP_CONTACT_EMAIL=contact_destination@example.com
# Development-only: enables project-scoped writes through /api/save-snapshot.
TULIP_ENABLE_SNAPSHOT_WRITES=false
# Optional and public: production telemetry stays disabled unless explicitly enabled.
VITE_TULIP_TELEMETRY_ENABLED=false
# Optional and public: allow browser-side checks against third-party source APIs.
VITE_TULIP_REMOTE_REFRESH_ENABLED=false
